# ============================================================
# SALON SAAS PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

PORT=6969
NODE_ENV=production
ALLOWED_ORIGINS=https://yoursalon.com,https://admin.yoursalon.com,https://panel.yoursalon.com

# Database (Production Primary Database)
MONGO_URI=mongodb+srv://prod_user:prod_pass@cluster.mongodb.net/salon-db-prod

# JWT Authentication Secrets (Must be set securely via Vault/Doppler/Secret Manager)
JWT_ACCESS_SECRET=prod_super_secure_access_secret_key_change_in_vault
JWT_REFRESH_SECRET=prod_super_secure_refresh_secret_key_change_in_vault
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis Cache
REDIS_URL=redis://prod-redis.internal:6379

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
