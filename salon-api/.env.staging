# ============================================================
# SALON SAAS PLATFORM — STAGING ENVIRONMENT CONFIGURATION
# ============================================================

PORT=6969
NODE_ENV=staging
ALLOWED_ORIGINS=https://staging.yoursalon.com,https://staging-admin.yoursalon.com,https://staging-panel.yoursalon.com

# Database (Staging Isolated Instance)
MONGO_URI=mongodb+srv://staging_user:staging_pass@cluster.mongodb.net/salon-db-staging

# JWT Authentication Secrets
JWT_ACCESS_SECRET=staging_jwt_access_secret_key_8493021
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_key_8493021
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis Cache
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=900000
