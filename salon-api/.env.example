# ================================
# Salon SaaS Platform - Environment Template
# ================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT .env TO VERSION CONTROL
# ================================

# Server
PORT=6969
NODE_ENV=development

# ================================
# JWT Secrets - GENERATE NEW ONES!
# ================================
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_64_char_hex_secret_here
JWT_REFRESH_SECRET=your_64_char_hex_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
EMAIL_VERIFICATION_SECRET=your_separate_64_char_hex_secret_here

# ================================
# CORS - Comma-separated origins
# ================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ================================
# Database - MongoDB Atlas
# ================================
# Format: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/salon_saas

# ================================
# Redis - Upstash or self-hosted
# ================================
REDIS_ENABLED=true
REDIS_URL=rediss://default:password@host:port
# OR individual components:
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# ================================
# Email - Brevo (Sendinblue)
# ================================
BREVO_API_KEY=xkeysib-your-api-key-here
MAIL_FROM=your-email@domain.com
MAIL_FROM_NAME=Your Salon App
EMAIL_FROM="Your Salon App" <your-email@domain.com>
APP_BASE_URL=https://your-domain.com

# ================================
# Google OAuth
# ================================
GOOGLE_CLIENT_IDS=your-web-client-id,your-android-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id

# ================================
# Google Maps
# ================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ================================
# Cloudflare R2 Storage
# ================================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=salon-saas-media
R2_PUBLIC_DOMAIN=https://pub-your-bucket.r2.dev